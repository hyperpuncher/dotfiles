#!/usr/bin/env python3

import configparser
import json
import locale
import os
import shutil
import sys
from pathlib import Path


def localized(section, key):
	language = locale.getlocale(locale.LC_MESSAGES)[0] or ""
	candidates = []
	if language:
		candidates.extend((f"{key}[{language}]", f"{key}[{language.split('_')[0]}]"))
	candidates.append(key)
	for candidate in candidates:
		if candidate in section:
			return section[candidate]
	return ""


def enabled_for_desktop(section):
	desktops = set(filter(None, os.environ.get("XDG_CURRENT_DESKTOP", "").split(":")))
	only = set(filter(None, section.get("OnlyShowIn", "").split(";")))
	excluded = set(filter(None, section.get("NotShowIn", "").split(";")))
	return (not only or bool(desktops & only)) and not bool(desktops & excluded)


def data_paths():
	data_home = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
	data_dirs = [Path(path) for path in os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")]
	return data_home, data_dirs


def fallback_icons(data_home, data_dirs):
	icons = {}
	for data_dir in (data_home, *data_dirs):
		root = data_dir / "icons/hicolor"
		if root.is_dir():
			candidates = sorted(
				(
					path
					for path in root.glob("*/apps/*")
					if path.suffix.lower() in {".svg", ".png", ".xpm"}
				),
				key=lambda path: (path.parent.parent.name != "scalable", path.name),
			)
			for path in candidates:
				icons.setdefault(path.stem, str(path))
				icons.setdefault(path.name, str(path))

		pixmaps = data_dir / "pixmaps"
		if pixmaps.is_dir():
			for path in pixmaps.iterdir():
				if path.is_file() and path.suffix.lower() in {".svg", ".png", ".xpm"}:
					icons.setdefault(path.stem, str(path))
					icons.setdefault(path.name, str(path))
	return icons


def watch():
	data_home, data_dirs = data_paths()
	paths = [str(path / "applications") for path in (data_home, *data_dirs) if (path / "applications").is_dir()]
	os.execvp("inotifywait", [
		"inotifywait", "--monitor", "--quiet", "--recursive",
		"--event", "close_write,create,delete,move", *paths,
	])


def desktop_entries():
	data_home, data_dirs = data_paths()
	icons = fallback_icons(data_home, data_dirs)
	seen = set()
	entries = []

	for data_dir in (data_home, *data_dirs):
		applications = data_dir / "applications"
		if not applications.is_dir():
			continue
		for path in applications.rglob("*.desktop"):
			desktop_id = str(path.relative_to(applications)).replace("/", "-")[:-8]
			if desktop_id in seen:
				continue
			seen.add(desktop_id)

			parser = configparser.ConfigParser(interpolation=None, strict=False)
			parser.optionxform = str
			try:
				parser.read(path, encoding="utf-8")
				section = parser["Desktop Entry"]
			except (configparser.Error, KeyError, OSError, UnicodeError):
				continue

			if section.get("Type") != "Application" or section.getboolean("Hidden", fallback=False):
				continue
			if section.getboolean("NoDisplay", fallback=False) or not enabled_for_desktop(section):
				continue
			try_exec = section.get("TryExec", "")
			if try_exec and not (Path(try_exec).is_file() if "/" in try_exec else shutil.which(try_exec)):
				continue
			name = localized(section, "Name")
			if not name:
				continue

			icon = section.get("Icon", "")
			icon_path = Path(icon)
			if not icon_path.is_absolute() or not icon_path.is_file():
				icon_path = Path(icons.get(icon, ""))

			entries.append({
				"id": desktop_id,
				"desktopEntryId": f"{desktop_id}.desktop",
				"name": name,
				"genericName": localized(section, "GenericName"),
				"comment": localized(section, "Comment"),
				"keywords": [word for word in localized(section, "Keywords").split(";") if word],
				"icon": icon,
				"iconPath": str(icon_path) if icon_path.is_file() else "",
				"path": str(path),
			})

	return entries


if len(sys.argv) == 2 and sys.argv[1] == "--watch":
	watch()
else:
	print(json.dumps(desktop_entries(), ensure_ascii=False, separators=(",", ":")))
