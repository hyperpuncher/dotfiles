#!/usr/bin/env python3

import re
import unicodedata
import urllib.request
import xml.etree.ElementTree as ET
from pathlib import Path

UNICODE_VERSION = ".".join(unicodedata.unidata_version.split(".")[:2])
CLDR_RELEASES = {"16.0": "46"}
CLDR_RELEASE = CLDR_RELEASES.get(UNICODE_VERSION, "latest")
CACHE = Path.home() / ".cache" / "quickshell" / "emoji-data" / UNICODE_VERSION
SOURCES = {
	"emoji-test.txt": f"https://www.unicode.org/Public/emoji/{UNICODE_VERSION}/emoji-test.txt",
	"annotations.xml": f"https://raw.githubusercontent.com/unicode-org/cldr/release-{CLDR_RELEASE}/common/annotations/en.xml",
	"annotations-derived.xml": f"https://raw.githubusercontent.com/unicode-org/cldr/release-{CLDR_RELEASE}/common/annotationsDerived/en.xml",
}


def source(name):
	path = CACHE / name
	if path.exists():
		return path
	CACHE.mkdir(parents=True, exist_ok=True)
	request = urllib.request.Request(SOURCES[name], headers={"User-Agent": "quickshell-emoji-data"})
	with urllib.request.urlopen(request, timeout=20) as response:
		path.write_bytes(response.read())
	return path


def normalized(text):
	return text.replace("\ufe0f", "")


def annotations():
	names = {}
	keywords = {}
	for filename in ("annotations.xml", "annotations-derived.xml"):
		for annotation in ET.parse(source(filename)).getroot().iter("annotation"):
			emoji = annotation.attrib.get("cp", "")
			value = (annotation.text or "").strip()
			if not emoji or not value:
				continue
			key = normalized(emoji)
			if annotation.attrib.get("type") == "tts":
				names[key] = value
			else:
				keywords.setdefault(key, set()).update(
					part.strip() for part in value.split("|") if part.strip()
				)
	return names, keywords


def emoji_rows():
	pattern = re.compile(
		r"^([0-9A-F ]+)\s*;\s*fully-qualified\s*#\s*\S+\s+E[0-9.]+\s+(.+)$"
	)
	group = ""
	subgroup = ""
	for line in source("emoji-test.txt").read_text(encoding="utf-8").splitlines():
		if line.startswith("# group: "):
			group = line.removeprefix("# group: ")
			continue
		if line.startswith("# subgroup: "):
			subgroup = line.removeprefix("# subgroup: ")
			continue
		match = pattern.match(line)
		if not match:
			continue
		codepoints, standard_name = match.groups()
		emoji = "".join(chr(int(value, 16)) for value in codepoints.split())
		yield emoji, group, subgroup, standard_name


def main():
	names, keyword_map = annotations()
	for emoji, group, subgroup, standard_name in emoji_rows():
		key = normalized(emoji)
		name = names.get(key, standard_name)
		keywords = sorted(keyword_map.get(key, set()) | {name})
		print(f"{emoji}\t{group}\t{subgroup}\t{name}\t{' | '.join(keywords)}")


if __name__ == "__main__":
	main()
